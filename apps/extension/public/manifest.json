{
  "manifest_version": 3,
  "name": "Fly Sensor",
  "version": "0.1.0",
  "minimum_chrome_version": "102",
  "description": "Reads the local Fly demo's explicit market attributes and sends snapshots to a paired loopback bridge.",
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1:5173/*"],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Pair Fly Sensor",
    "default_popup": "pairing.html"
  },
  "options_page": "pairing.html",
  "content_scripts": [
    {
      "matches": ["http://127.0.0.1:5173/*"],
      "js": ["src/content.js"],
      "run_at": "document_idle"
    }
  ]
}

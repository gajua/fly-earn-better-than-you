{
  "manifest_version": 3,
  "name": "Fly Earn Better Than You",
  "version": "0.2.0",
  "minimum_chrome_version": "116",
  "description": "Extension-first Fly observer for supported broker tabs. Observation and paper trading only; never auto-submits live orders.",
  "permissions": ["storage", "tabs"],
  "optional_host_permissions": [
    "http://127.0.0.1:5173/*",
    "http://127.0.0.1:5174/*"
  ],
  "host_permissions": [
    "http://127.0.0.1:5173/*",
    "http://127.0.0.1:5174/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Fly status",
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["http://127.0.0.1:5173/*", "http://127.0.0.1:5174/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}

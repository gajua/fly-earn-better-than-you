{
  "name": "fly-earn-better-than-you",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.1",
  "scripts": {
    "dev": "pnpm --filter @fly/demo dev",
    "build": "pnpm --filter @fly/demo build && pnpm --filter @fly/extension build && pnpm --filter @fly/desktop exec vite build",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run packages apps/desktop/src apps/extension/src",
    "test:e2e": "playwright test",
    "test:python": "services/brain/.venv/bin/python -m pytest -q services/brain/tests",
    "test:rust": "cargo test --manifest-path apps/desktop/src-tauri/Cargo.toml",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@playwright/test": "^1.55.0",
    "eslint": "^9.35.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
